# FreeLLMAPI Unified Gateway Configuration (Default)
# Router URL running locally on port 31415:
VITE_FREELLM_BASE_URL=http://127.0.0.1:31415/v1
# Unified key starting with freellma...
VITE_FREELLM_API_KEY=freellma_your_unified_key_here

# Direct Google Gemini API Key (Alternative Direct Provider)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Self-Hosted VPS Authentication & Sync Backend (Ra Server)
# VPS endpoint pointing to your self-hosted backend, e.g. https://api.cosmowhisper.com or https://auth.yourdomain.com
VITE_AUTH_PROVIDER_URL=https://api.cosmowhisper.com
# Provider type: "node-jwt" | "pocketbase" | "supabase"
VITE_AUTH_PROVIDER_TYPE=node-jwt
